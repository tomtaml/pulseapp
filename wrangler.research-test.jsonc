{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulse-srf-research-test",
  "main": "src/research-test-entry.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulse-research-test-eu-v2",
      "database_id": "1b9f67e2-631e-4fe5-9f4f-a249a651fc67",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_EXPECTED_HOSTNAME": "",
    "RESEARCH_ALLOWED_ORIGIN": "",
    "COLLECTION_ENABLED": "false",
    "FREE_TEXT_ENABLED": "false",
    "RESEARCH_FREE_TEXT_APPROVED": "false",
    "ENVIRONMENT": "preview",
    "CHARGING_BACKEND_MODE": "mock",
    "CHARGING_COMMANDS_ENABLED": "false"
  }
}
