{
  "name": "pulse-srf-workshop-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:research-test": "wrangler deploy --config wrangler.research-test.jsonc",
    "health:research-test": "wrangler dev --config wrangler.research-test.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply pulse-srf-workshop --local",
    "db:migrate:remote": "wrangler d1 migrations apply pulse-srf-workshop --remote",
    "db:migrate:research-test": "wrangler d1 migrations apply pulse-research-test-eu-v2 --remote --config wrangler.research-test.jsonc",
    "db:list:research-test": "wrangler d1 migrations list pulse-research-test-eu-v2 --remote --config wrangler.research-test.jsonc",
    "db:synthetic:research-test": "wrangler d1 execute pulse-research-test-eu-v2 --remote --config wrangler.research-test.jsonc --file=./scripts/synthetic_research_insert.sql",
    "types": "wrangler types",
    "qr": "python3 scripts/make_qr.py",
    "preview:static": "python3 -m http.server 8080 -d public"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
